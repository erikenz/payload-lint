language js

// Require `payload.find` / `payload.findByID` / `payload.findGlobal` /
// `payload.findVersions` / `payload.findVersionByID` calls with `depth`
// greater than 0 to pass an explicit `populate` object, so the fields of
// populated related documents are intentional instead of returning the full
// document or whatever `defaultPopulate` is configured to on each collection.
// See https://payloadcms.com/docs/queries/select#populate
//
// Heuristic: only fires when `depth` is a positive numeric literal (a
// variable or computed depth cannot be verified). Calls with `select` that
// only covers scalar fields may still be flagged even though nothing would
// be populated — the correct fix there is `depth: 0`.
//
// Note: if the target collection defines `defaultPopulate` in its config,
// Payload already limits which fields are returned during population. Suppress
// this diagnostic with the linter-specific ignore comment documented in the
// package README.
//
// Skipped (cannot be verified statically, avoids false positives):
// - calls where the arguments are not an object literal (`payload.find(args)`)
// - calls with a spread inside the arguments (`{ ...base, collection: 'x' }`)
// - calls where `depth` is not a numeric literal (variable, computed, shorthand)
// - `payload.db.*` direct-database calls (receiver does not end in `.payload`)
`$recv.$op($args)` as $call where {
	$recv <: or {
		`payload`,
		`$x.payload`
	},
	$op <: or {
		`find`,
		`findByID`,
		`findGlobal`,
		`findVersions`,
		`findVersionByID`
	},
	$args <: JsObjectExpression(),
	$args <: contains `depth: $d`,
	$d <: JsNumberLiteralExpression(),
	! $d <: "0",
	! $args <: contains or {
		`populate: $_`,
		`populate`
	},
	! $args <: contains JsSpread(),
	register_diagnostic(span=$call, message="Payload queries with `depth` greater than 0 should specify `populate` to control which fields of populated related documents are returned. See https://payloadcms.com/docs/queries/select#populate", severity="error")
}
