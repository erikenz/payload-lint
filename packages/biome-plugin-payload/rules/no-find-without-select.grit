language js

// Require `payload.find` / `payload.findByID` / `payload.findGlobal` /
// `payload.findVersions` / `payload.findVersionByID` calls to pass a `select`
// object so only the fields that are actually needed are fetched from the
// database.
// See https://payloadcms.com/docs/queries/select
//
// Skipped (cannot be verified statically, avoids false positives):
// - calls where the arguments are not an object literal (`payload.find(args)`)
// - calls with a spread inside the arguments (`{ ...base, collection: 'x' }`)
// - `payload.db.*` direct-database calls (receiver does not end in `.payload`)
`$recv.$op($args)` as $call where {
	$recv <: or {
		`payload`,
		`$x.payload`
	},
	$op <: or {
		`find`,
		`findByID`,
		`findGlobal`,
		`findVersions`,
		`findVersionByID`
	},
	$args <: JsObjectExpression(),
	! $args <: contains or {
		`select: $_`,
		`select`
	},
	! $args <: contains JsSpread(),
	register_diagnostic(span=$call, message="Payload queries should specify `select` to only fetch the fields that are needed. See https://payloadcms.com/docs/queries/select", severity="error")
}
