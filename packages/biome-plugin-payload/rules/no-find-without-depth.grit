language js

// Require `payload.find` / `payload.findByID` / `payload.findGlobal` /
// `payload.findVersions` / `payload.findVersionByID` calls to set `depth`
// explicitly. Omitting `depth` uses the application default (1 by default,
// configurable via `defaultDepth` in payload.config.ts), which silently
// populates one level of relationships — almost always not what you want
// inside server code that should be predictable and fast.
// See https://payloadcms.com/docs/queries/depth
//
// Skipped (cannot be verified statically, avoids false positives):
// - calls where the arguments are not an object literal (`payload.find(args)`)
// - calls with a spread inside the arguments (`{ ...base, collection: 'x' }`)
// - `payload.db.*` direct-database calls (receiver does not end in `.payload`)
`$recv.$op($args)` as $call where {
	$recv <: or {
		`payload`,
		`$x.payload`
	},
	$op <: or {
		`find`,
		`findByID`,
		`findGlobal`,
		`findVersions`,
		`findVersionByID`
	},
	$args <: JsObjectExpression(),
	! $args <: contains or {
		`depth: $_`,
		`depth`
	},
	! $args <: contains JsSpread(),
	register_diagnostic(span=$call, message="Payload queries should set `depth` explicitly. Omitting it uses the application default (1), which populates one level of relationships. Use `depth: 0` to disable population. See https://payloadcms.com/docs/queries/depth", severity="error")
}
