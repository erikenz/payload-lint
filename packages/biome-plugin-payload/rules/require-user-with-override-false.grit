// Require `user` (or `req`, which carries `req.user`) to be passed whenever
// `overrideAccess: false` is set on a Payload Local API call. Setting
// `overrideAccess: false` enables access control checks, but those checks run
// with `undefined` as the user if neither `user` nor `req` is provided, which
// causes unpredictable behavior in any access function that inspects `req.user`.
//
// All of these patterns are accepted:
//   await payload.find({ ..., overrideAccess: false, user })        // explicit user
//   await payload.find({ ..., overrideAccess: false, req })         // Payload reads req.user
//   await payload.find({ ..., overrideAccess: false, user: null })   // explicit anonymous access
//
// For public-facing Server Components where no req/user exists, pass user: null explicitly
// or suppress this diagnostic with the linter-specific ignore comment documented
// in the package README.
//
// See https://payloadcms.com/docs/local-api/access-control
//
// Skipped (cannot be verified statically, avoids false positives):
// - calls where the arguments are not an object literal
// - calls with a spread inside the arguments
// - calls where `overrideAccess` is not the literal `false`
//   (variable/computed values cannot be verified)
`$recv.$op($args)` as $call where {
	$recv <: or {
		`payload`,
		`$x.payload`
	},
	$op <: or {
		`find`,
		`findByID`,
		`findVersions`,
		`findVersionByID`,
		`create`,
		`update`,
		`updateByID`,
		`delete`,
		`deleteByID`,
		`count`,
		`findDistinct`,
		`findGlobal`,
		`updateGlobal`,
		`login`,
		`unlock`
	},
	$args <: JsObjectExpression(),
	$args <: contains `overrideAccess: false`,
	! $args <: contains or {
		`user: $_`,
		`user`,
		`req: $_`,
		`req`
	},
	! $args <: contains JsSpread(),
	register_diagnostic(span=$call, message="When `overrideAccess: false` is set, pass `user`, `req`, or `user: null` so Payload knows whose permissions to check. Without them, access control functions receive `undefined` as the user. For explicit unauthenticated access, pass `user: null`.", severity="error")
}
