	"require-user-with-override-false": {
		"message": "When `overrideAccess: false` is set, pass `user`, `req`, or `user: null` so Payload knows whose permissions to check. Without them, access control functions receive `undefined` as the user. For explicit unauthenticated access, pass `user: null`.",
		"cases": [
			{
				"name": "flags overrideAccess: false without user",
				"fixture": "user/01-override-false-no-user.ts",
				"diagnostics": 1
			},
