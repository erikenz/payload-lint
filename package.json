{
	"name": "payload-lint",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "biome check .",
		"fix": "bunx sort-package-json package.json packages/*/package.json && biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"publish:biome": "bun publish --cwd packages/biome-plugin-payload",
		"publish:oxlint": "bun publish --cwd packages/oxlint-plugin-payload",
		"test": "bun run --workspaces test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"oxlint": "1.89.0",
		"payload": "3.92.0",
		"vitest": "5.0.5"
	},
	"packageManager": "bun@1.3.14"
}
